# 한국투자증권 API 설정
APP_KEY=your_app_key_here
APP_SECRET=your_app_secret_here
ACCOUNT_NO=your_account_number_here

# Database 설정
DB_HOST=db
DB_PORT=5432
DB_NAME=autofire
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Trading 설정
MAX_BUY_AMOUNT=1000000
SLIPPAGE_TOLERANCE=0.5
STOP_LOSS=-3.0
TAKE_PROFIT=5.0
SELECT_COUNT=5
ACTIVE_STRATEGIES=RSI_Strategy

# Discord 알림
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# 환경 설정
ENV=development
