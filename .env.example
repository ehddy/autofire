# ===== KIS API 설정 =====
APP_KEY=your_app_key_here
APP_SECRET=your_app_secret_here
ACCOUNT_NO=your_account_number_here
IS_PAPER_TRADING=true   # true: 모의투자, false: 실전투자

# ===== 스케줄 설정 =====
SELECTION_TIME=08:30        # 종목 선정 시간 (HH:MM)
REPORT_TIME=16:00           # 마감 리포트 시간 (HH:MM)
MARKET_OPEN_TIME=09:00      # 장 시작 시간 (HH:MM)
MARKET_CLOSE_TIME=15:20     # 장 마감/강제청산 시간 (HH:MM)
MONITOR_INTERVAL=1          # 모니터링 주기 (분)

# ===== 전략 설정 =====
# 주의: RiskManagement_Strategy를 첫 번째에 배치하여 익절/손절 우선순위 보장
ACTIVE_STRATEGIES=RiskManagement_Strategy,RSI_Strategy,BollingerBand_Strategy
SELECTION_POLICIES=TechnicalSelector,VolumeSelector

# ===== 매매 설정 =====
MAX_BUY_AMOUNT=1000000          # 최대 매수 금액
SLIPPAGE_TOLERANCE=0.5          # 슬리피지 허용 범위
STOP_LOSS=-2.0                  # 손절 기준 (%)
TAKE_PROFIT=3.0                 # 익절 기준 (%)
DAILY_STOP_LOSS=-3.0            # 일일 손절 기준 (%)
SELECT_COUNT=5                  # 선정 종목 수

# ===== DB 설정 =====
DB_HOST=db
DB_PORT=5432
DB_NAME=autofire
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ===== 알림 설정 =====
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# ===== 환경 설정 =====
ENV=development
